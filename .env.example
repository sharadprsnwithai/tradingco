# ==============================================================================
# Multi-Broker Trading Bot Environment Configuration
# Copy this file to .env and fill in your actual credentials
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (PostgreSQL / R2DBC)
R2DBC_URL=r2dbc:h2:mem:///tradingbot;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DB_USER=sa
DB_PASSWORD=

# ------------------------------------------------------------------------------
# Zerodha Kite Connect Configuration
# ------------------------------------------------------------------------------
KITE_ENABLED=true
KITE_USER_ID=your_kite_user_id
KITE_PASSWORD=your_kite_password
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_TOTP_SECRET=your_kite_totp_secret_key_base32
KITE_BASE_URL=https://api.kite.trade

# ------------------------------------------------------------------------------
# Shoonya (Finvasia NorenAPI) OAuth Configuration
# ------------------------------------------------------------------------------
SHOONYA_ENABLED=true
SHOONYA_USER_ID=your_shoonya_user_id
SHOONYA_ACCOUNT_ID=your_shoonya_account_id
SHOONYA_CLIENT_ID=your_shoonya_client_id
SHOONYA_SECRET_KEY=your_shoonya_secret_key
SHOONYA_PASSWORD=your_shoonya_password
SHOONYA_TOTP_SECRET=your_shoonya_totp_secret_key_base32
SHOONYA_VENDOR_CODE=your_shoonya_vendor_code
SHOONYA_API_KEY=your_shoonya_api_key
SHOONYA_BASE_URL=https://api.shoonya.com

# ------------------------------------------------------------------------------
# Telegram Alerts & Ops Kill Switch (Optional)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
